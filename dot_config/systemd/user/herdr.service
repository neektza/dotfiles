[Unit]
Description=Herdr terminal session server
Documentation=https://herdr.dev/tui/docs/session-state/

[Service]
Type=exec
WorkingDirectory=%h
Environment="PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/herdr server
Restart=on-failure
RestartSec=5s
# Give the server time to save its session and stop its panes before forcing exit.
KillMode=mixed
TimeoutStopSec=30s

[Install]
WantedBy=default.target
