# Ghostty config for pwrbook (macOS).

# --- font / appearance ---
font-family = "MesloLGS NF"
font-size = 16
cursor-style = block
cursor-style-blink = false
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
macos-titlebar-style = transparent
macos-option-as-alt = true

# --- default theme, auto-switches with macOS appearance ---
theme = dark:Gruvbox Dark,light:Gruvbox Light

# --- shared tab shortcuts for herdr, Zellij, and tmux ---
# Send their Ctrl+B prefix followed by c or a tab number.
# All other keyboard shortcuts use Ghostty defaults.
keybind = cmd+t=text:\x02c
# Remove physical digit bindings so they cannot open Ghostty tabs instead.
keybind = super+digit_1=unbind
keybind = super+digit_2=unbind
keybind = super+digit_3=unbind
keybind = super+digit_4=unbind
keybind = super+digit_5=unbind
keybind = super+digit_6=unbind
keybind = super+digit_7=unbind
keybind = super+digit_8=unbind
keybind = super+digit_9=unbind
keybind = cmd+1=text:\x021
keybind = cmd+2=text:\x022
keybind = cmd+3=text:\x023
keybind = cmd+4=text:\x024
keybind = cmd+5=text:\x025
keybind = cmd+6=text:\x026
keybind = cmd+7=text:\x027
keybind = cmd+8=text:\x028
keybind = cmd+9=text:\x029
