# Use herdr's built-in defaults. Ghostty sends Ctrl+B c/1..9 for Cmd+T/1..9.
onboarding = false
{{ if eq .chezmoi.hostname "pwrbook" }}
# Follow Ghostty's macOS appearance changes, including in remote workspaces.
[theme]
name = "gruvbox"
auto_switch = true
dark_name = "gruvbox"
light_name = "gruvbox-light"
{{ end }}
